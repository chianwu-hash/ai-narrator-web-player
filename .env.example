# 書庫根目錄；播放器只會掃描這個資料夾與其直接子資料夾
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace_with_drive_root_folder_id

# Google service account（只播放可用檢視者；若啟用 /admin/covers 則需編輯者）
GOOGLE_SERVICE_ACCOUNT_EMAIL=ai-narrator-reader@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# 優先使用認證碼的 SHA-256；不要把原始認證碼提交到 Git
APP_ACCESS_CODE_SHA256=replace_with_64_character_sha256_hex

# 至少 32 個隨機字元；用來簽署 HttpOnly session cookie
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# 任意變更此值，就能讓所有既有登入立即失效
AUTH_VERSION=1

# 管理後台使用獨立管理者碼；正式環境建議只設定 SHA-256，不保存明文
ADMIN_ACCESS_CODE_SHA256=replace_with_64_character_sha256_hex

# 任意變更此值，就能讓所有既有管理者登入立即失效
ADMIN_AUTH_VERSION=1

# 本機尚未連接 Drive 時可設為 mock；Vercel 正式環境請移除此欄
DRIVE_MODE=mock

# Supabase sync. Keep this server-side only. Use a Supabase Secret key
# (sb_secret_...) or a legacy service_role key.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Production audio bytes should stream through Cloudflare Worker, not Vercel.
# Leave unset in local/mock environments that intentionally use fallback behavior.
AUDIO_WORKER_URL=https://replace-with-worker-subdomain.workers.dev
AUDIO_SIGNING_SECRET=replace_with_random_secret_at_least_32_characters
AUDIO_URL_TTL_SECONDS=21600
AUDIO_TOKEN_BROKER_SECRET=replace_with_second_random_secret_at_least_32_characters
