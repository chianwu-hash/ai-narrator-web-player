# Vercel (Production and the Preview environment used for acceptance testing)
AUDIO_WORKER_URL=https://ai-narrator-audio.example.workers.dev
AUDIO_SIGNING_SECRET=replace-with-the-same-random-secret-at-least-32-characters
AUDIO_URL_TTL_SECONDS=21600

# Cloudflare Worker secrets (set with `wrangler secret put`, never as plaintext vars)
GOOGLE_SERVICE_ACCOUNT_EMAIL=ai-narrator-reader@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=replace-with-the-existing-read-only-service-account-private-key

# Cloudflare Worker plain vars
ALLOWED_ORIGINS=https://ai-narrator-web-player.vercel.app
AUDIO_MAX_RANGE_BYTES=4194304
MAX_SIGNED_URL_TTL_SECONDS=86400
